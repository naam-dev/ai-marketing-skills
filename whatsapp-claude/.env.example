# ---- Claude (both paths need this) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=1024
# CLAUDE_SYSTEM_PROMPT=You are a friendly WhatsApp concierge for Acme Co...
# CLAUDE_THINKING=on        # turn on adaptive thinking for harder questions (slower)
HISTORY_TURNS=20

# ---- Meta WhatsApp Cloud API (whatsapp_claude_bot.py / send_message.py) ----
WHATSAPP_TOKEN=EAAG...                 # System User / permanent access token
WHATSAPP_PHONE_NUMBER_ID=1234567890    # WhatsApp > API Setup page
WHATSAPP_VERIFY_TOKEN=pick-any-string  # you also paste this into the webhook setup
WHATSAPP_APP_SECRET=                    # App > Settings > Basic (enables signature check)
WHATSAPP_GRAPH_VERSION=v21.0

# ---- Twilio sandbox (twilio_whatsapp_bot.py) ----
# No extra keys needed for the sandbox — Twilio authenticates the inbound webhook
# by the URL you configure. Only ANTHROPIC_API_KEY above is required.
