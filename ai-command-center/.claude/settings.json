{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/fence.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/acc:*)",
      "Bash(scripts/acc:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Edit(./scripts/**)",
      "Edit(./.claude/settings.json)"
    ]
  }
}
