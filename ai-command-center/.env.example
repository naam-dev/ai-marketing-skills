# AI Command Center environment. Copied to .env (chmod 600) by setup-server.sh.

# Your main vault. The fence keeps the command center out of it.
ACC_VAULT_PATH=/srv/brain

# Max minutes per shift, in seconds.
ACC_SHIFT_TIMEOUT=1800

# Only if the team user isn't logged in to Claude with /login:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
